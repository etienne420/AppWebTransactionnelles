    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {\r\n  const response = pm.response.json();\r\n  if (typeof response.token === 'string' && response.token !== '') {\r\n    pm.environment.set('jeton_postman', response.token);\r\n  }\r\n}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"membre@example.com\",\r\n    \"password\": \"password\"\r\n}",
